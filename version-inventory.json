{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "src/B47ANCEDUI/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDUI/42/media/lua/client/B47ANCEDUI/API.lua",
      "pattern": "^U.version='(?P<version>[^']+)'$"
    },
    {
      "path": "README.md",
      "pattern": "^Development version: (?P<version>\\S+)\\.$"
    },
    {
      "path": "docs/API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/ARCHITECTURE.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/TESTING.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/MOD_OVERVIEW.json",
      "pattern": "^  \"version\": \"(?P<version>[^\\\"]+)\""
    },
    {
      "path": "docs/WORKSHOP_CHANGELOG.md",
      "pattern": "^Version (?P<version>\\S+)$"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/current/*.zip",
        "pattern": "B47ANCEDUI-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "B47ANCEDUI/42/mod.info",
            "pattern": "^modversion=(?P<version>[^\\r\\n]+)\\r?$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "mod.info:versionMin",
      "reason": "Game target distinct from project version."
    },
    {
      "category": "compatibility",
      "reference": "API.lua:apiVersion",
      "reason": "Independent public Lua API major."
    }
  ],
  "historical": [
    {
      "reference": "docs/PROVENANCE.json",
      "reason": "Original owner-approved Quartermaster source version/commit/hashes; not current UI validation."
    },
    {
      "reference": "docs/WORKSHOP_PUBLICATION.md; docs/WORKSHOP_PUBLICATION_2026-10-18.json",
      "reason": "Immutable dated first upload/distribution proof; exact original version, commits and hashes are never upgraded to later source/runtime evidence."
    },
    {
      "reference": "docs/WORKSHOP_PREPARATION.md",
      "reason": "Original pre-upload preparation for 0.1.0-dev.1; not current source validation."
    }
  ]
}
